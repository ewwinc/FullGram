 // Row models shared by the Full Gram and Full Gram settings pages.
+
+/// Refresh open settings pages when their icon style changes, including parent pages
+/// under the icon picker. The observer is disposed together with the page's signal.
+func fullgramSettingsPresentationData(context: AccountContext) -> Signal<PresentationData, NoError> {
+    let icons = Signal<Void, NoError> { subscriber in
+        let observer = NotificationCenter.default.addObserver(forName: FullGramSettingsIcons.didChangeNotification, object: nil, queue: .main) { _ in
+            subscriber.putNext(Void())
+        }
+        subscriber.putNext(Void())
+        return ActionDisposable { NotificationCenter.default.removeObserver(observer) }
+    }
+    return combineLatest(context.sharedContext.presentationData, icons)
+    |> map { data, _ in data }
+}
 
