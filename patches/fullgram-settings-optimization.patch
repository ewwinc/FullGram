--- a/submodules/SettingsUI/SnapshotTests/FullGramSettingsSnapshotTests.swift
+++ b/submodules/SettingsUI/SnapshotTests/FullGramSettingsSnapshotTests.swift
@@ -11,6 +11,52 @@
 
 /// Baselines must be captured/reviewed on the pinned simulator, never synthesized on Linux.
 final class FullGramSettingsSnapshotTests: XCTestCase {
+    @MainActor
+    func testSettingsIconStyleAndCache() throws {
+        let key = "fullgram.appearance.monochromeSettingsIcons"
+        let saved = UserDefaults.standard.object(forKey: key)
+        defer {
+            if let saved { UserDefaults.standard.set(saved, forKey: key) }
+            else { UserDefaults.standard.removeObject(forKey: key) }
+        }
+        UserDefaults.standard.removeObject(forKey: key)
+        XCTAssertFalse(FullGramSettingsIcons.monochrome)
+        let renderers: [() -> UIImage?] = [
+            { FullGramSettingsIcons.symbol("paintbrush.fill", color: .systemPink) },
+            { FullGramSettingsIcons.glyph("Item List/Icons/Premium", color: .systemPurple) },
+            { FullGramSettingsIcons.telegram(color: .systemBlue) },
+            { FullGramSettingsIcons.ghost(color: .systemPurple, plus: true) },
+            { FullGramSettingsIcons.plugin(size: 30.0) }
+        ]
+        let coloured = try renderers.map { try XCTUnwrap($0()) }
+        for (index, render) in renderers.enumerated() {
+            XCTAssertTrue(coloured[index] === render(), "An unchanged icon must reuse its rasterization")
+        }
+        FullGramSettingsIcons.monochrome = true
+        XCTAssertTrue(UserDefaults.standard.bool(forKey: key))
+        for (index, render) in renderers.enumerated() {
+            let mono = try XCTUnwrap(render())
+            XCTAssertEqual(mono.size, coloured[index].size)
+            XCTAssertFalse(mono === coloured[index])
+            XCTAssertTrue(mono === render())
+            let bytes = try pixels(XCTUnwrap(mono.cgImage))
+            var hasWhiteGlyph = false
+            for pixel in stride(from: 0, to: bytes.count, by: 4) {
+                XCTAssertEqual(bytes[pixel], bytes[pixel + 1])
+                XCTAssertEqual(bytes[pixel + 1], bytes[pixel + 2])
+                if bytes[pixel] > 200 { hasWhiteGlyph = true }
+            }
+            XCTAssertTrue(hasWhiteGlyph, "The vector glyph must still be visible")
+            let before = FullGramSectionedEntry.link(0, 1, coloured[index], "Icon", "")
+            let after = FullGramSectionedEntry.link(0, 1, mono, "Icon", "")
+            XCTAssertNotEqual(before, after, "A style-only change must redraw the row")
+        }
+        let swatch = try XCTUnwrap(FullGramSettingsIcons.symbol("circle.fill", color: .systemRed, preserveColor: true))
+        FullGramSettingsIcons.monochrome = false
+        XCTAssertTrue(swatch === FullGramSettingsIcons.symbol("circle.fill", color: .systemRed, preserveColor: true))
+        for (index, render) in renderers.enumerated() { XCTAssertTrue(coloured[index] === render()) }
+    }
+
     @MainActor
     func testSettingsPreviews() throws {
         fullgramRegisterMessageShotPreview()
