+    }
+
+    /// Keep the final rasterization, not a bitmap for every row refresh. NSCache is
+    /// thread-safe and evicts under memory pressure; size, colour and scale are keys.
+    private static func cachedImage(_ name: String, color: UIColor = .clear, draw: () -> UIImage?) -> UIImage? {
+        let resolved = color.resolvedColor(with: UITraitCollection.current)
+        var red: CGFloat = 0.0, green: CGFloat = 0.0, blue: CGFloat = 0.0, alpha: CGFloat = 0.0
+        resolved.getRed(&red, green: &green, blue: &blue, alpha: &alpha)
+        let key = "\(name):\(red):\(green):\(blue):\(alpha):\(UIScreen.main.scale)" as NSString
+        if let image = images.object(forKey: key) {
+            return image
+        }
+        guard let image = draw() else { return nil }
+        let cost = image.cgImage.map { $0.bytesPerRow * $0.height } ?? 0
+        images.setObject(image, forKey: key, cost: cost)
+        return image
+    }
