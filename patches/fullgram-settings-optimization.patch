+    public static let didChangeNotification = Notification.Name("FullGram.SettingsIconsChanged")
+
+    /// Missing preferences keep the original coloured icons, including after an upgrade.
+    public static var monochrome: Bool {
+        get { return UserDefaults.standard.bool(forKey: monochromeKey) }
+        set {
+            guard newValue != monochrome else { return }
+            UserDefaults.standard.set(newValue, forKey: monochromeKey)
