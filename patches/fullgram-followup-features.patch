+    private var fullgramRegistryCacheUrl: URL? {
+        FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first?
+            .appendingPathComponent("Full Gram", isDirectory: true)
+            .appendingPathComponent("fullgram-ios-badges.json")
+    }
+
     private func loadCached() {
         guard let url = self.cacheUrl, let data = try? Data(contentsOf: url) else { return }
         self.parse(data: data)
     }
 
+    private func loadFullGramRegistryCache() {
+        guard let url = self.fullgramRegistryCacheUrl, let data = try? Data(contentsOf: url) else { return }
+        self.parseFullGramRegistry(data: data)
+    }
+
+    private func refreshFullGramRegistry() {
+        guard let url = URL(string: "https://raw.githubusercontent.com/FullGram/FullGram-IOS/main/assets/fullgram_ios_badges.json") else { return }
+        var request = URLRequest(url: url)
+        request.timeoutInterval = 15.0
+        URLSession(configuration: .ephemeral).dataTask(with: request) { [weak self] data, response, _ in
+            guard let self, let data, let http = response as? HTTPURLResponse, http.statusCode == 200 else { return }
+            self.parseFullGramRegistry(data: data)
+            if let cacheUrl = self.fullgramRegistryCacheUrl {
+                try? FileManager.default.createDirectory(at: cacheUrl.deletingLastPathComponent(), withIntermediateDirectories: true)
+                try? data.write(to: cacheUrl, options: .atomic)
+            }
+        }.resume()
+    }
+
+    private func parseFullGramRegistry(data: Data) {
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any], let badges = json["badges"] as? [[String: Any]] else { return }
+        var parsed: [Int64: (documentId: Int64?, text: String?)] = [:]
+        for badge in badges {
+            guard let id = (badge["id"] as? NSNumber)?.int64Value else {
+                continue
+            }
+            parsed[id] = ((badge["documentId"] as? NSNumber)?.int64Value, badge["title"] as? String)
+        }
+        self.lock.lock()
+        self.fullgramIosBadges = parsed
+        self.lock.unlock()
+    }
+
     private func refresh() {
         guard !self.isRefreshing else { return }
         self.isRefreshing = true
