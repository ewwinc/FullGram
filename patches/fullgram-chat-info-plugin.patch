+/// Aggregated statistics of a chat's locally stored messages (for `fullgram.messages.stats`).
+public struct FullGramChatStatistics {
+    public struct Word {
+        public let word: String
+        public let count: Int
+    }
+
+    public let messageCount: Int
+    public let voiceCount: Int
+    public let roundVideoCount: Int
+    public let firstTimestamp: Int32?
+    public let lastTimestamp: Int32?
+    public let frequentWords: [Word]
+    public let rareWords: [Word]
+    /// Words were counted over `wordSampleSize` newest messages, not necessarily the whole chat.
+    public let wordSampleSize: Int
+    /// The scan stopped at the message cap before reaching the oldest stored message.
+    public let truncated: Bool
+}
+
 public extension TelegramEngine.Messages {
+    /// Counts, media kinds, word frequencies and the first/last timestamps of the chat's stored
+    /// messages. Text is tokenised for at most `wordLimit` newest messages so a very large chat
+    /// still answers promptly; the counters cover up to `maxMessages` messages.
+    func fullgramChatStatistics(peerId: EnginePeer.Id, maxMessages: Int = 100000, wordLimit: Int = 20000) -> Signal<FullGramChatStatistics, NoError> {
+        return self.account.postbox.transaction { transaction -> FullGramChatStatistics in
+            let namespace = peerId.namespace == Namespaces.Peer.SecretChat ? Namespaces.Message.Local : Namespaces.Message.Cloud
+            let lowerBound = MessageIndex.lowerBound(peerId: peerId, namespace: namespace)
+            let upperBound = MessageIndex.upperBound(peerId: peerId, namespace: namespace)
+            let messageCap = max(1, maxMessages)
+            let textCap = max(0, wordLimit)
+            var before: MessageIndex?
+            var messageCount = 0
+            var voiceCount = 0
+            var roundVideoCount = 0
+            var firstTimestamp: Int32?
+            var lastTimestamp: Int32?
+            var words: [String: Int] = [:]
+            var wordSampleSize = 0
+            var truncated = false
+            while true {
+                let page = transaction.getMessages(peerId: peerId, namespace: namespace, from: before ?? upperBound, includeFrom: false, to: lowerBound, limit: 1000)
+                if page.isEmpty {
+                    break
+                }
+                for message in page {
+                    if messageCount >= messageCap {
+                        truncated = true
+                        break
+                    }
+                    messageCount += 1
+                    if message.timestamp > 0 {
+                        if firstTimestamp == nil || message.timestamp < firstTimestamp! {
+                            firstTimestamp = message.timestamp
+                        }
+                        if lastTimestamp == nil || message.timestamp > lastTimestamp! {
+                            lastTimestamp = message.timestamp
+                        }
+                    }
+                    for media in message.media {
+                        guard let file = media as? TelegramMediaFile else { continue }
+                        if file.isVoice {
+                            voiceCount += 1
+                        } else if file.isInstantVideo {
+                            roundVideoCount += 1
+                        }
+                    }
+                    if wordSampleSize < textCap {
+                        wordSampleSize += 1
+                        for word in message.text.lowercased().split(whereSeparator: { !$0.isLetter }) where word.count >= 3 && word.count <= 40 {
+                            words[String(word), default: 0] += 1
+                        }
+                    }
+                }
+                if truncated || messageCount >= messageCap {
+                    truncated = true
+                    break
+                }
+                guard let oldest = page.map({ $0.index }).min(), oldest != before else { break }
+                before = oldest
+            }
+            let frequentWords = words.sorted(by: { $0.value == $1.value ? $0.key < $1.key : $0.value > $1.value }).prefix(10).map { FullGramChatStatistics.Word(word: $0.key, count: $0.value) }
+            let rareWords = words.sorted(by: { $0.value == $1.value ? $0.key < $1.key : $0.value < $1.value }).prefix(10).map { FullGramChatStatistics.Word(word: $0.key, count: $0.value) }
+            return FullGramChatStatistics(messageCount: messageCount, voiceCount: voiceCount, roundVideoCount: roundVideoCount, firstTimestamp: firstTimestamp, lastTimestamp: lastTimestamp, frequentWords: frequentWords, rareWords: rareWords, wordSampleSize: wordSampleSize, truncated: truncated)
+        }
+    }
+
