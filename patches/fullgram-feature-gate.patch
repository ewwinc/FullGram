+import Foundation
+
+/// FullGramFeatureGate as seen by the interface layer (the gate itself lives in TelegramCore under
+/// the same key). Until `fullgram://unlock` is opened, the restricted extras read as off.
+public enum FullGramFeatureGateUI {
+    public static var isUnlocked: Bool {
+        return UserDefaults.standard.bool(forKey: "fullgram.gate.unlocked")
+    }
+
+    static let restrictedExtras: Set<FullGramExtras.Key> = [.saveViewOnce, .stayAfterBan, .notifyDeleted, .readAfterReaction, .alwaysOnline]
+}
