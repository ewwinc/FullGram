+    }
+    let extent = input.extent
+    let blurred = input.clampedToExtent()
+    .applyingFilter("CIGaussianBlur", parameters: [kCIInputRadiusKey: extent.width * 0.08])
+    .applyingFilter("CIColorControls", parameters: [kCIInputSaturationKey: 1.2])
+    .cropped(to: extent)
+    guard let cgImage = CIContext(options: nil).createCGImage(blurred, from: extent) else {
+        return nil
+    }
+    return UIImage(cgImage: cgImage)
+}
