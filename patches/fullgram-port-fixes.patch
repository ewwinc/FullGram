diff --git a/submodules/AccountContext/Sources/FullGramPluginHostExtras.swift b/submodules/AccountContext/Sources/FullGramPluginHostExtras.swift
new file mode 100644
index 00000000..047b90b0
--- /dev/null
+++ b/submodules/AccountContext/Sources/FullGramPluginHostExtras.swift
@@ -0,0 +1,258 @@
+import Foundation
+import UIKit
+import CryptoKit
+import AVFoundation
+import UserNotifications
+import Display
+
+/// Host calls added with the 27.6 plugin API: hashing and encodings, app and device facts, the
+/// clipboard, speech, local reminders and haptic patterns. `FullGramPluginHostAPI.handle` hands every
+/// call it does not know to `handle` here; nil means the call is unknown or was refused.
+enum FullGramPluginHostExtras {
+    private static let maxText = 1_000_000
+
+    static func handle(pluginId: String, op: String, args: [String: Any], allowed: (FullGramPluginPermission) -> Bool) -> Any? {
+        func string(_ key: String, _ limit: Int = maxText) -> String {
+            return String((args[key] as? String ?? "").prefix(limit))
+        }
+        func number(_ key: String, _ fallback: Double) -> Double {
+            return (args[key] as? NSNumber)?.doubleValue ?? fallback
+        }
+        func value(_ result: Any?) -> Any {
+            return ["value": result ?? NSNull()]
+        }
+
+        switch op {
+        // Hashes and encodings: pure, no permission.
+        case "crypto.sha256":
+            return value(hex(Data(SHA256.hash(data: Data(string("text").utf8)))))
+        case "crypto.sha1":
+            return value(hex(Data(Insecure.SHA1.hash(data: Data(string("text").utf8)))))
+        case "crypto.sha512":
+            return value(hex(Data(SHA512.hash(data: Data(string("text").utf8)))))
+        case "crypto.md5":
+            return value(hex(Data(Insecure.MD5.hash(data: Data(string("text").utf8)))))
+        case "crypto.hmac":
+            let key = SymmetricKey(data: Data(string("key", 4096).utf8))
+            return value(hex(Data(HMAC<SHA256>.authenticationCode(for: Data(string("text").utf8), using: key))))
+        case "crypto.randomBytes":
+            let count = max(1, min(1024, Int(number("count", 16))))
+            var bytes = [UInt8](repeating: 0, count: count)
+            guard SecRandomCopyBytes(kSecRandomDefault, count, &bytes) == errSecSuccess else {
+                return value(nil)
+            }
+            return value(Data(bytes).base64EncodedString())
+        case "crypto.uuid":
+            return value(UUID().uuidString.lowercased())
+        case "encoding.base64Encode":
+            return value(Data(string("text").utf8).base64EncodedString())
+        case "encoding.base64Decode":
+            return value(Data(base64Encoded: string("text"), options: .ignoreUnknownCharacters).flatMap { String(data: $0, encoding: .utf8) })
+        case "encoding.hexEncode":
+            return value(hex(Data(string("text").utf8)))
+        case "encoding.hexDecode":
+            return value(unhex(string("text")).flatMap { String(data: $0, encoding: .utf8) })
+
+        // The app itself: no permission.
+        case "app.version":
+            return value(Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String)
+        case "app.build":
+            return value(Bundle.main.infoDictionary?["CFBundleVersion"] as? String)
+        case "app.name":
+            return value("Full Gram")
+        case "app.plugins":
+            return value(FullGramScriptRuntime.shared.plugins.map { ["id": $0.id, "name": $0.name, "enabled": $0.enabled] })
+
+        // Device facts, behind `device`. The app may be waiting for the plugin on the main thread,
+        // so UIKit values come from a snapshot the main thread refreshes after every read.
+        case "device.battery", "device.isCharging", "device.screen", "device.darkMode":
+            guard allowed(.device) else { return nil }
+            let snapshot = uiSnapshot()
+            DispatchQueue.main.async { refreshUISnapshot() }
+            return value(snapshot[String(op.dropFirst("device.".count))])
+        case "device.model":
+            guard allowed(.device) else { return nil }
+            var system = utsname()
+            uname(&system)
+            let machine = withUnsafeBytes(of: &system.machine) { buffer in
+                String(decoding: buffer.prefix(while: { $0 != 0 }), as: UTF8.self)
+            }
+            return value(machine)
+        case "device.systemVersion":
+            guard allowed(.device) else { return nil }
+            let version = ProcessInfo.processInfo.operatingSystemVersion
+            return value("\(version.majorVersion).\(version.minorVersion).\(version.patchVersion)")
+        case "device.timezone":
+            guard allowed(.device) else { return nil }
+            return value(["id": TimeZone.current.identifier, "offsetMinutes": TimeZone.current.secondsFromGMT() / 60])
+        case "device.isLowPower":
+            guard allowed(.device) else { return nil }
+            return value(ProcessInfo.processInfo.isLowPowerModeEnabled)
+        case "device.freeDisk":
+            guard allowed(.device) else { return nil }
+            let attributes = try? FileManager.default.attributesOfFileSystem(forPath: NSHomeDirectory())
+            return value((attributes?[.systemFreeSize] as? NSNumber)?.int64Value)
+        case "device.memory":
+            guard allowed(.device) else { return nil }
+            return value(Int64(ProcessInfo.processInfo.physicalMemory))
+        case "device.uptime":
+            guard allowed(.device) else { return nil }
+            return value(ProcessInfo.processInfo.systemUptime)
+        case "device.thermalState":
+            guard allowed(.device) else { return nil }
+            let names: [ProcessInfo.ThermalState: String] = [.nominal: "nominal", .fair: "fair", .serious: "serious", .critical: "critical"]
+            return value(names[ProcessInfo.processInfo.thermalState] ?? "nominal")
+
+        // The clipboard: reading needs its own permission; iOS shows its paste notice.
+        case "clipboard.read", "clipboard.hasText":
+            guard allowed(op == "clipboard.read" ? .clipboardRead : .clipboard) else { return nil }
+            // Answered later, as `uiResult`, once the main thread has read the pasteboard.
+            let requestId = string("requestId", 64)
+            DispatchQueue.main.async {
+                let answer: Any
+                if op == "clipboard.read" {
+                    answer = ["value": UIPasteboard.general.string.map { String($0.prefix(maxText)) as Any } ?? NSNull()]
+                } else {
+                    answer = ["value": UIPasteboard.general.hasStrings]
+                }
+                FullGramPluginUI.send("uiResult", to: pluginId, ["requestId": requestId, "choice": answer])
+            }
+            return ["ok": true]
+        case "clipboard.clear":
+            guard allowed(.clipboard) else { return nil }
+            DispatchQueue.main.async { UIPasteboard.general.items = [] }
+            return ["ok": true]
+
+        // Speech, behind `ui`.
+        case "speech.speak":
+            guard allowed(.ui) else { return nil }
+            let text = string("text", 4000)
+            let language = string("language", 16)
+            let rate = Float(max(0.1, min(1.0, number("rate", Double(AVSpeechUtteranceDefaultSpeechRate)))))
+            DispatchQueue.main.async {
+                let utterance = AVSpeechUtterance(string: text)
+                utterance.rate = rate
+                utterance.voice = AVSpeechSynthesisVoice(language: language.isEmpty ? Locale.preferredLanguages.first : language)
+                FullGramPluginSpeech.synthesizer.speak(utterance)
+            }
+            return ["ok": true]
+        case "speech.stop":
+            guard allowed(.ui) else { return nil }
+            DispatchQueue.main.async { FullGramPluginSpeech.synthesizer.stopSpeaking(at: .immediate) }
+            return ["ok": true]
+        case "speech.isSpeaking":
+            guard allowed(.ui) else { return nil }
+            return value(FullGramPluginSpeech.synthesizer.isSpeaking)
+        case "speech.voices":
+            guard allowed(.ui) else { return nil }
+            return value(Array(Set(AVSpeechSynthesisVoice.speechVoices().map(\.language))).sorted())
+
+        // Local reminders, behind `notifications`. Each plugin sees only its own.
+        case "notify.schedule":
+            guard allowed(.notifications) else { return nil }
+            let id = string("id", 64)
+            let content = UNMutableNotificationContent()
+            content.title = string("title", 200)
+            content.body = string("body", 1000)
+            content.sound = .default
+            let trigger = UNTimeIntervalNotificationTrigger(timeInterval: max(1.0, min(60.0 * 60.0 * 24.0 * 30.0, number("seconds", 5.0))), repeats: false)
+            let identifier = reminderPrefix(pluginId) + (id.isEmpty ? UUID().uuidString : id)
+            UNUserNotificationCenter.current().add(UNNotificationRequest(identifier: identifier, content: content, trigger: trigger))
+            return value(String(identifier.dropFirst(reminderPrefix(pluginId).count)))
+        case "notify.cancel":
+            guard allowed(.notifications) else { return nil }
+            UNUserNotificationCenter.current().removePendingNotificationRequests(withIdentifiers: [reminderPrefix(pluginId) + string("id", 64)])
+            return ["ok": true]
+        case "notify.cancelAll":
+            guard allowed(.notifications) else { return nil }
+            let prefix = reminderPrefix(pluginId)
+            UNUserNotificationCenter.current().getPendingNotificationRequests { requests in
+                UNUserNotificationCenter.current().removePendingNotificationRequests(withIdentifiers: requests.map(\.identifier).filter { $0.hasPrefix(prefix) })
+            }
+            return ["ok": true]
+
+        // A row of taps: up to 16 styles, 30-1000 ms apart.
+        case "haptics.pattern":
+            guard allowed(.haptics), !FullGramExtras.hapticsDisabled else { return nil }
+            let styles = Array((args["styles"] as? [String] ?? []).prefix(16))
+            let interval = max(0.03, min(1.0, number("interval", 120.0) / 1000.0))
+            DispatchQueue.main.async {
+                for (index, style) in styles.enumerated() {
+                    DispatchQueue.main.asyncAfter(deadline: .now() + interval * Double(index)) {
+                        let kind: UIImpactFeedbackGenerator.FeedbackStyle
+                        switch style {
+                        case "light": kind = .light
+                        case "heavy": kind = .heavy
+                        case "soft": kind = .soft
+                        case "rigid": kind = .rigid
+                        default: kind = .medium
+                        }
+                        UIImpactFeedbackGenerator(style: kind).impactOccurred()
+                    }
+                }
+            }
+            return ["ok": true]
+        default:
+            return nil
+        }
+    }
+
+    private static func reminderPrefix(_ pluginId: String) -> String {
+        return "fullgram.plugin.\(pluginId)."
+    }
+
+    private static let snapshotLock = NSLock()
+    private static var snapshot: [String: Any] = [:]
+
+    private static func uiSnapshot() -> [String: Any] {
+        snapshotLock.lock()
+        defer { snapshotLock.unlock() }
+        if snapshot.isEmpty {
+            // The first read, before the main thread ever ran: what Foundation can tell.
+            return ["battery": NSNull(), "isCharging": false, "screen": NSNull(), "darkMode": false]
+        }
+        return snapshot
+    }
+
+    /// Main thread only.
+    static func refreshUISnapshot() {
+        let device = UIDevice.current
+        device.isBatteryMonitoringEnabled = true
+        let screen = UIScreen.main
+        let value: [String: Any] = [
+            "battery": device.batteryLevel < 0 ? NSNull() as Any : Double(device.batteryLevel) as Any,
+            "isCharging": device.batteryState == .charging || device.batteryState == .full,
+            "screen": ["width": Double(screen.bounds.width), "height": Double(screen.bounds.height), "scale": Double(screen.scale)],
+            "darkMode": screen.traitCollection.userInterfaceStyle == .dark
+        ]
+        snapshotLock.lock()
+        snapshot = value
+        snapshotLock.unlock()
+    }
+
+    private static func hex(_ data: Data) -> String {
+        return data.map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func unhex(_ text: String) -> Data? {
+        let characters = Array(text.lowercased().filter { !$0.isWhitespace })
+        guard characters.count % 2 == 0 else {
+            return nil
+        }
+        var data = Data(capacity: characters.count / 2)
+        var index = 0
+        while index < characters.count {
+            guard let byte = UInt8(String(characters[index ..< index + 2]), radix: 16) else {
+                return nil
+            }
+            data.append(byte)
+            index += 2
+        }
+        return data
+    }
+}
+
+/// One synthesizer for every plugin, so a new phrase can stop the one before.
+private enum FullGramPluginSpeech {
+    static let synthesizer = AVSpeechSynthesizer()
+}
