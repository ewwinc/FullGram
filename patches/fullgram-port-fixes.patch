+    private func genius() {
+        let query = [self.artist, FullGramMusicMetadata.searchTitle(self.title)].compactMap { $0 }.joined(separator: " ")
+        guard var components = URLComponents(string: "https://api.popcat.xyz/v2/lyrics") else {
