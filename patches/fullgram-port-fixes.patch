+            self.providerDone()
+            return
+        }
+        self.load(url, completion: { [weak self] response in
+            guard let self else { return }
+            // A miss answers {"error": true, "message": {"error": "Song not found!"}}.
+            if let record = (self.json(response) as? [String: Any])?["message"] as? [String: Any], let raw = record["lyrics"] as? String, let text = fullgramCleanGeniusLyrics(raw) {
+                let score = FullGramMusicMetadata.matchScore(candidateTitle: record["title"] as? String ?? "", candidateArtist: record["artist"] as? String, candidateDuration: nil, title: self.title, artist: self.artist, duration: self.duration)
+                // Search, not an exact lookup: plain text, never above lyrics.ovh's exact path.
+                if score >= 0.55 {
+                    self.offer(FullGramLyricsCandidate(lyrics: .plain(text), source: "Genius", score: min(score, 0.75)))
+                }
+            }
