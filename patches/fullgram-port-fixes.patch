+private func fullgramAddGrantedGiftMessage(transaction: Transaction, accountPeerId: PeerId, chatPeerId: PeerId, incoming: Bool, row: ProfileGiftsContext.State.StarGift, isUpgrade: Bool, isTransferred: Bool = false, timestamp: Int32) -> Bool {
