+/// Upgrades the account's plain granted gift for free: draws a model, backdrop and pattern from
+/// `attributes`, has the badge server commit them and returns the new profile row for the reveal.
+public func fullgramUpgradeGrantedGift(account: Account, reference: StarGiftReference, attributes: [StarGift.UniqueGift.Attribute]) -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    guard let index = fullgramGrantedGiftIndex(reference), let granted = FullGramSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.index == index }) else {
+        return .fail(.generic)
+    }
+    guard granted.kind == .plain else {
+        return .fail(.alreadyUpgraded)
+    }
+    let attributesSignal: Signal<[StarGift.UniqueGift.Attribute], NoError>
+    if attributes.isEmpty {
+        attributesSignal = _internal_getStarGiftUpgradeAttributes(account: account, giftId: granted.giftId)
+        |> take(1)
+        |> map { $0 ?? [] }
+    } else {
+        attributesSignal = .single(attributes)
+    }
+    let ru = fullgramRussian()
+    return attributesSignal
+    |> castError(UpgradeStarGiftError.self)
+    |> mapToSignal { attributes -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+        let model = fullgramRandomAttributeName(attributes) { attribute in
+            if case let .model(name, _, rarity, _) = attribute { return (name, rarity.permilleValue) }
+            return nil
+        }
+        let pattern = fullgramRandomAttributeName(attributes) { attribute in
+            if case let .pattern(name, _, rarity) = attribute { return (name, rarity.permilleValue) }
+            return nil
+        }
+        let backdrop = fullgramRandomAttributeName(attributes) { attribute in
+            if case let .backdrop(name, _, _, _, _, _, rarity) = attribute { return (name, rarity.permilleValue) }
+            return nil
+        }
+        guard let model, let pattern, let backdrop else {
+            return .fail(.generic)
+        }
+        return FullGramBadgeServer.post(account: account, route: "upgrade", body: ["index": granted.index, "model": model, "backdrop": backdrop, "pattern": pattern], ru: ru)
+        |> mapError { _ -> UpgradeStarGiftError in
+            return .generic
+        }
+        |> mapToSignal { _ -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+            guard let upgraded = FullGramSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.index == index && $0.kind == .unique }) else {
+                return .fail(.generic)
+            }
+            return fullgramGrantedGiftRows(account: account, peerId: account.peerId, granted: [upgraded])
+            |> castError(UpgradeStarGiftError.self)
+            |> mapToSignal { rows -> Signal<ProfileGiftsContext.State.StarGift, UpgradeStarGiftError> in
+                guard let row = rows.first else {
+                    return .fail(.generic)
+                }
+                return .single(row)
+            }
+        }
+    }
+}
+
+private func fullgramRussian() -> Bool {
+    let language = Locale.preferredLanguages.first ?? ""
+    return language.hasPrefix("ru") || language.hasPrefix("uk")
+}
+
+/// Has the badge server change the account's own granted gift at `reference`.
+private func fullgramHeldGiftRequest(account: Account, route: String, reference: StarGiftReference?, body: [String: Any]) -> Signal<Data, String> {
+    var body = body
+    if let reference {
+        guard let index = fullgramGrantedGiftIndex(reference) else {
+            return .fail("not a granted gift")
+        }
+        body["index"] = index
+    }
+    return FullGramBadgeServer.post(account: account, route: route, body: body, ru: fullgramRussian())
+}
+
+/// Wears the account's unique granted gift at `reference` as its emoji status in FullGram-IOS, or
+/// takes off whichever one it wears when `worn` is false.
+public func fullgramWearGrantedGift(account: Account, reference: StarGiftReference?, worn: Bool) -> Signal<Never, String> {
+    return fullgramHeldGiftRequest(account: account, route: "wear", reference: worn ? reference : nil, body: ["worn": worn])
+    |> ignoreValues
+}
+
+/// Whether the account wears one of its granted gifts.
+public func fullgramWearsGrantedGift(account: Account) -> Bool {
+    return FullGramSupportersManager.shared.grantedGifts(peerId: account.peerId.id._internalGetInt64Value()).contains(where: { $0.worn })
+}
+
+/// Signs the account's granted gift: `text` becomes its message. Empty text clears it.
+public func fullgramSignGrantedGift(account: Account, reference: StarGiftReference, text: String) -> Signal<Never, String> {
+    return fullgramHeldGiftRequest(account: account, route: "sign", reference: reference, body: ["text": text])
+    |> ignoreValues
+}
+
+/// The current signature of the account's granted gift at `reference`.
+public func fullgramGrantedGiftText(account: Account, reference: StarGiftReference?) -> String? {
+    guard let index = fullgramGrantedGiftIndex(reference) else {
+        return nil
+    }
+    return FullGramSupportersManager.shared.grantedGifts(peerId: account.peerId.id._internalGetInt64Value()).first(where: { $0.index == index })?.text
+}
+
+/// Transfers the account's unique granted gift to `peerId`, and shows it as sent in the chat with them.
+public func fullgramTransferGrantedGift(account: Account, reference: StarGiftReference, peerId: EnginePeer.Id) -> Signal<Never, TransferStarGiftError> {
+    let accountPeerId = account.peerId.id._internalGetInt64Value()
+    guard let index = fullgramGrantedGiftIndex(reference), let gift = FullGramSupportersManager.shared.grantedGifts(peerId: accountPeerId).first(where: { $0.index == index }), gift.kind == .unique else {
+        return .fail(.generic)
+    }
+    let recipientId = peerId.id._internalGetInt64Value()
+    return fullgramHeldGiftRequest(account: account, route: "transfer", reference: reference, body: ["to": String(recipientId)])
+    |> mapError { _ -> TransferStarGiftError in
+        return .generic
+    }
+    |> mapToSignal { _ -> Signal<Never, TransferStarGiftError> in
+        guard let moved = FullGramSupportersManager.shared.grantedGifts(peerId: recipientId).first(where: { $0.giftId == gift.giftId && $0.number == gift.number && $0.fromId == accountPeerId }) else {
+            return .complete()
+        }
+        return fullgramGrantedGiftRows(account: account, peerId: peerId, granted: [moved])
+        |> take(1)
+        |> mapToSignal { rows -> Signal<Never, NoError> in
+            guard let row = rows.first else {
+                return .complete()
+            }
+            return account.postbox.transaction { transaction -> Void in
+                let _ = fullgramAddGrantedGiftMessage(transaction: transaction, accountPeerId: account.peerId, chatPeerId: peerId, incoming: false, row: row, isUpgrade: false, isTransferred: true, timestamp: moved.date > 0 ? moved.date : Int32(Date().timeIntervalSince1970))
+            }
+            |> ignoreValues
+        }
+        |> castError(TransferStarGiftError.self)
+    }
+}
