+    /// The Full Gram mark (two blades and the core between them), 66 × 54.
+    fileprivate static func fullGramMarkImage(color: UIColor) -> UIImage {
+        let size = CGSize(width: 66.0, height: 54.0)
+        // The mark's outline in its drawing units (assets/branding/fullgram/mark.py), 646 × 519.
+        let left: [CGPoint] = [CGPoint(x: 296.6, y: 0.0), CGPoint(x: 296.6, y: 298.5), CGPoint(x: 171.1, y: 519.0), CGPoint(x: 0.0, y: 519.0)]
+        let right = left.map { CGPoint(x: 646.2 - $0.x, y: $0.y) }
+        let core: [CGPoint] = [CGPoint(x: 323.1, y: 341.0), CGPoint(x: 424.8, y: 519.0), CGPoint(x: 221.4, y: 519.0)]
+        return UIGraphicsImageRenderer(size: size).image { context in
+            let c = context.cgContext
+            let scale = (size.width - 4.0) / 646.2
+            c.translateBy(x: 2.0, y: (size.height - 519.0 * scale) / 2.0)
+            c.scaleBy(x: scale, y: scale)
+            c.setLineJoin(.round)
+            c.setLineWidth(14.0)
+            for (shape, alpha) in [(left, 1.0), (right, 1.0), (core, 0.72)] as [([CGPoint], CGFloat)] {
+                c.setFillColor(color.withAlphaComponent(alpha).cgColor)
+                c.setStrokeColor(color.withAlphaComponent(alpha).cgColor)
+                c.addLines(between: shape)
+                c.closePath()
+                c.drawPath(using: .fillStroke)
+            }
+        }
+    }
+}
