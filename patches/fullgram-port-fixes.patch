+/// Granted gifts as profile gift rows, in the order given. A gift whose base gift or attributes
+/// Telegram does not return is left out.
+private func fullgramGrantedGiftRows(account: Account, peerId: EnginePeer.Id, granted: [FullGramGrantedGift]) -> Signal<[ProfileGiftsContext.State.StarGift], NoError> {
+    guard !granted.isEmpty else {
+        return .single([])
+    }
+    let catalog = _internal_cachedStarGifts(postbox: account.postbox)
+    |> take(1)
+    let uniqueIds = Array(Set(granted.filter { $0.kind == .unique }.map(\.giftId)))
+    let attributes = combineLatest(uniqueIds.map { giftId in
+        return _internal_getStarGiftUpgradeAttributes(account: account, giftId: giftId)
+        |> take(1)
+        |> map { (giftId, $0 ?? []) }
+    })
+    let ru = fullgramRussian()
+    let isOwn = peerId == account.peerId
+    return combineLatest(catalog, attributes)
+    |> map { catalog, attributes -> [ProfileGiftsContext.State.StarGift] in
+        var generic: [Int64: StarGift.Gift] = [:]
+        for gift in catalog?.items ?? [] {
+            if case let .generic(value) = gift {
+                generic[value.id] = value
+            }
+        }
+        let attributesById = Dictionary(attributes, uniquingKeysWith: { first, _ in first })
+        return granted.compactMap { item -> ProfileGiftsContext.State.StarGift? in
+            let gift: StarGift
+            var reference: StarGiftReference?
+            var canUpgrade = false
+            var transferStars: Int64?
+            switch item.kind {
+            case .plain:
+                guard let base = generic[item.giftId] else { return nil }
+                gift = .generic(base)
+                // The holder upgrades a plain gift from the gift screen; it is priced as fullgramGrantedUpgradePrice and costs nothing.
+                if isOwn && base.upgradeStars != nil {
+                    reference = .slug(slug: fullgramGrantReferencePrefix + "\(item.index)")
+                    canUpgrade = true
+                }
+            case .unique:
+                guard let unique = fullgramUniqueGift(item, title: generic[item.giftId]?.title ?? "Gift", attributes: attributesById[item.giftId] ?? [], ownerPeerId: peerId) else { return nil }
+                gift = .unique(unique)
+                // The holder transfers it for free, to anyone.
+                if isOwn {
+                    reference = .slug(slug: fullgramGrantReferencePrefix + "\(item.index)")
+                    transferStars = 0
+                }
+            }
+            return ProfileGiftsContext.State.StarGift(gift: gift, reference: reference, fromPeer: nil, date: item.date, text: item.text ?? FullGramGrantedGift.note(ru), entities: nil, nameHidden: false, savedToProfile: true, pinnedToTop: true, convertStars: nil, canUpgrade: canUpgrade, canExportDate: nil, upgradeStars: nil, transferStars: transferStars, canTransferDate: nil, canResaleDate: nil, collectionIds: nil, prepaidUpgradeHash: nil, upgradeSeparate: false, dropOriginalDetailsStars: nil, number: item.kind == .unique ? item.number : nil, isRefunded: false, canCraftAt: nil)
+        }
+    }
+}
