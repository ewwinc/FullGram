{
  "format": "fullgram-ios-plugin",
  "apiVersion": 6,
  "id": "branch_hook_demo",
  "name": "Branch hook demo",
  "author": "FullGram-IOS",
  "version": "1.0",
  "summary": "Strip text; !text becomes uppercase, other text becomes a lowercase note.",
  "actions": [
    {
      "id": "send_program",
      "title": "Converted outgoing text",
      "kind": "outgoingReplace",
      "program": {
        "instructions": [
          {
            "op": "strip"
          },
          {
            "op": "branch",
            "condition": {
              "kind": "prefix",
              "value": "!",
              "negated": false
            },
            "body": [
              {
                "op": "removePrefix",
                "value": "!"
              },
              {
                "op": "upper"
              }
            ],
            "otherwise": [
              {
                "op": "lower"
              },
              {
                "op": "prepend",
                "value": "[note] "
              }
            ]
          }
        ]
      }
    }
  ],
  "convertedFrom": "FullGram/ast-send-hook-v2",
  "sourceSHA256": "a82d395ca65fccc52e6a3ee4b7174d1970f6c28084981ea767d281c9583048f5",
  "limitations": [
    "Converted to a native text program. Original plugin code is not executed.",
    "Plain cloud text only; formatted text, media captions, forwards and secret chats are unchanged.",
    "Output is limited to 8192 UTF-8 bytes and 4096 UTF-16 units. Empty/oversized results retain the original text.",
    "Only the mapped operations are supported; Java views, external dependencies and other hooks are rejected."
  ]
}
